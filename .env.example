# Copy this file to .env.local (never committed, see .gitignore) so that
# `npm run demo` (demo/server.mjs) can run a real Discord OAuth flow
# during a local demo — same values as the ones set on Netlify (site
# dashboard → Environment variables), just duplicated here for the demo
# panel, which runs outside Netlify.

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_STATE_SECRET=

# Add this redirect in Discord Developer Portal > OAuth2 > Redirects, on
# top of the ones already used by prod/netlify dev:
#   http://127.0.0.1:4100/discord/callback
