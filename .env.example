# Copie ce fichier en .env.local (jamais committé, cf. .gitignore) pour que
# `npm run demo` (demo/server.mjs) puisse faire un vrai flux OAuth Discord
# pendant une démo locale — mêmes valeurs que celles posées sur Netlify
# (dashboard du site → Environment variables), juste dupliquées ici pour le
# panneau de démo qui tourne en dehors de Netlify.

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_STATE_SECRET=

# Ajoute cette redirection dans Discord Developer Portal > OAuth2 >
# Redirects, en plus de celles déjà utilisées par la prod/netlify dev :
#   http://127.0.0.1:4100/discord/callback
