# Copy this file to .env.local (never committed, see .gitignore) to point
# the front at a local Hardhat node instead of Sepolia — useful to test
# the whole cycle (application -> vote -> execution) in a few seconds
# rather than real days, via networkHelpers.time.increase.
#
# VITE_CHAIN accepts "local" (this file's default), "l2" (Base Sepolia —
# not yet a real deployment, see composables/chainMode.ts), or anything
# else/unset for Sepolia (today's real deployment).

VITE_CHAIN=local

# Address shown by `npx hardhat ignition deploy ... --network localhost`
# (it changes on every local node restart, unlike Sepolia).
VITE_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
